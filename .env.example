# Create a .env file in the root directory of your project and add the following variables.
# Make sure you fill in all the values.

# Brevo Email API Configuration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@domain.com

# PayHere Payment Gateway Configuration
# Get these from: https://sandbox.payhere.lk/merchant -> Settings -> Integrations
PAYHERE_MERCHANT_ID=YOUR_MERCHANT_ID_HERE
PAYHERE_MERCHANT_SECRET=YOUR_MERCHANT_SECRET_HERE
PAYHERE_SANDBOX=true
